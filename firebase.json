{
  "hosting": {
    "public": "hosting/public",
    "predeploy": ["node hosting/hosting.mjs check"],
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      { "source": "/dev/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/dev/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/dev/version.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      {
        "source": "/dev/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
